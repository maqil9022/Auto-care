# Auto Lab 360 — Backend Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Configuration
# Set USE_POSTGRES=True when your PostgreSQL instance is running.
USE_POSTGRES=False
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autocare_db
SQLITE_DB_PATH=autocare.db

# WhatsApp Notification & Messaging Configuration (Sri Lanka)
# Modes: simulated, manual, cloud_api
WHATSAPP_MODE=simulated
WHATSAPP_GARAGE_NAME=Auto Lab 360
WHATSAPP_GARAGE_PHONE=071-881 8898 / 071-881 8854
WHATSAPP_GARAGE_ADDRESS=No 787, Kandy Road, Meepitiya, Kegalle
WHATSAPP_GARAGE_EMAIL=autolab360lk@gmail.com

# Optional Meta WhatsApp Cloud API credentials
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
